#!/usr/bin/env python3
"""Make a copy of Conky that survives its Wayland startup font bug.

Conky's Wayland output (src/output/display-wayland.cc) does

    void display_output_wayland::set_font(unsigned int f) {
      assert(f < pango_fonts.size());
      if (pango_fonts.size() > f && pango_fonts[f].desc != nullptr) {
        pango_layout_set_font_description(global_window->layout, pango_fonts[f].desc);
      }
    }

and calls set_font() once before load_fonts() has filled pango_fonts. Distro
builds keep asserts on, so Conky aborts at startup on Wayland. Without the
assert the call would simply do nothing, which is what we want.

Compiled, every copy of that body looks like this (the function itself, and
any place the compiler inlined it):

    cmp  rsi,rax            ; f < size ?
    jae  <assert>           ; no -> __assert_fail("f < pango_fonts.size()", ..., set_font)
    lea  rax,[rsi+rsi*2]
    mov  rsi,[rdx+rax*8]    ; desc
    test rsi,rsi
    je   <skip>             ; desc == nullptr -> skip the pango call
    ... call/jmp pango_layout_set_font_description

The fix points each `jae <assert>` at `<skip>`: an out-of-range font then takes
the same path as a font without a description. Only the 4-byte jump distance
changes; the instructions in between only touch rax/rsi/flags.

A copy is patched only when all of these hold, so nothing else is touched:
  - the exact instruction shape above;
  - the jae leads to an __assert_fail block naming display_output_wayland::set_font;
  - a call or tail jump through the GOT slot of pango_layout_set_font_description
    follows the je.
No symbols or fixed addresses are needed, so it works on Arch's build, CachyOS's
x86-64-v3/v4 rebuilds (which inline set_font in a second place) and later
versions with the same code.

Usage: patch-conky-wayland SRC DST
Exit:  0 patched copy written to DST
       3 this Conky build does not have the expected code (nothing written)
       1 other error (nothing written)
"""
import os
import re
import shutil
import struct
import sys
import tempfile

PANGO_SYMBOL = b"pango_layout_set_font_description"
SET_FONT_NAME = b"conky::display_output_wayland::set_font("
R_X86_64_GLOB_DAT = 6
R_X86_64_JUMP_SLOT = 7

SHAPE = re.compile(
    rb"\x48\x39\xc6\x0f\x83(?P<jae>[\s\S]{4})"            # cmp rsi,rax ; jae rel32
    rb"\x48\x8d\x04\x76\x48\x8b\x34\xc2\x48\x85\xf6"      # lea ; mov ; test rsi,rsi
    rb"\x74(?P<je>[\s\S])"                                # je rel8
)
ASSERT_SCAN = 16   # bytes at the jae target searched for `lea rcx,[set_font name]`
PANGO_SCAN = 48    # bytes after the je searched for the pango call


class Unsupported(Exception):
    pass


class Elf:
    def __init__(self, data):
        if data[:4] != b"\x7fELF" or data[4] != 2 or data[5] != 1:
            raise Unsupported("not a 64-bit little-endian ELF file")
        if struct.unpack_from("<H", data, 18)[0] != 62:
            raise Unsupported("not an x86-64 binary")
        self.data = data
        shoff = struct.unpack_from("<Q", data, 0x28)[0]
        shentsize, shnum, shstrndx = struct.unpack_from("<HHH", data, 0x3A)
        raw = [struct.unpack_from("<IIQQQQIIQQ", data, shoff + i * shentsize) for i in range(shnum)]
        names = raw[shstrndx][4]
        self.sections = [
            {"name": self.cstr(names + s[0]).decode(), "type": s[1], "addr": s[3],
             "offset": s[4], "size": s[5], "link": s[6]}
            for s in raw
        ]

    def cstr(self, off):
        return self.data[off:self.data.index(b"\0", off)]

    def section(self, name):
        for s in self.sections:
            if s["name"] == name:
                return s
        raise Unsupported(f"no {name} section")

    def vma(self, off):
        for s in self.sections:
            if s["addr"] and s["type"] != 8 and s["offset"] <= off < s["offset"] + s["size"]:
                return off - s["offset"] + s["addr"]
        return None

    def off(self, vma):
        for s in self.sections:
            if s["addr"] and s["type"] != 8 and s["addr"] <= vma < s["addr"] + s["size"]:
                return vma - s["addr"] + s["offset"]
        return None

    def got_slot(self, symbol):
        for sec in self.sections:
            if sec["type"] != 4 or sec["link"] == 0:  # SHT_RELA with a symbol table
                continue
            symtab = self.sections[sec["link"]]
            strtab = self.sections[symtab["link"]]
            for i in range(sec["size"] // 24):
                r_offset, r_info, _ = struct.unpack_from("<QQq", self.data, sec["offset"] + i * 24)
                if r_info & 0xFFFFFFFF not in (R_X86_64_GLOB_DAT, R_X86_64_JUMP_SLOT):
                    continue
                st_name = struct.unpack_from("<I", self.data, symtab["offset"] + (r_info >> 32) * 24)[0]
                if self.cstr(strtab["offset"] + st_name) == symbol:
                    return r_offset
        raise Unsupported(f"no relocation for {symbol.decode()} (not a Wayland-enabled Conky?)")


def set_font_names(elf):
    """Addresses of the assert function-name strings for set_font()."""
    ro = elf.section(".rodata")
    blob = elf.data[ro["offset"]:ro["offset"] + ro["size"]]
    found = set()
    for m in re.finditer(re.escape(SET_FONT_NAME), blob):
        start = blob.rfind(b"\0", 0, m.start()) + 1
        found.add(ro["addr"] + start)
    if not found:
        raise Unsupported("no set_font() assert message (asserts disabled in this build? then no fix is needed)")
    return found


def rip_targets(elf, off, end, opcode, length):
    """VMAs referenced by `opcode rel32` (RIP-relative) instructions in [off, end)."""
    for m in re.finditer(re.escape(opcode), elf.data[off:end]):
        at = off + m.start()
        if at + length > end:
            break
        rel = struct.unpack_from("<i", elf.data, at + len(opcode))[0]
        yield at, elf.vma(at) + length + rel


def find_patches(elf):
    text = elf.section(".text")
    names = set_font_names(elf)
    slot = elf.got_slot(PANGO_SYMBOL)
    base, end = text["offset"], text["offset"] + text["size"]

    patches = []
    for m in SHAPE.finditer(elf.data, base, end):
        jae_off = m.start() + 3
        je_off = m.end() - 2
        skip_vma = elf.vma(je_off) + 2 + struct.unpack("<b", m.group("je"))[0]
        new_rel = skip_vma - (elf.vma(jae_off) + 6)
        old_rel = struct.unpack("<i", m.group("jae"))[0]

        # The pango call (non-tail `call [rip]` or tail `jmp [rip]`) after the je.
        window_end = min(je_off + 2 + PANGO_SCAN, end)
        if not any(t == slot for op in (b"\xff\x15", b"\xff\x25")
                   for _, t in rip_targets(elf, je_off + 2, window_end, op, 6)):
            continue

        if old_rel == new_rel:
            patches.append((jae_off, new_rel, True))
            continue

        # The jae must lead to __assert_fail(..., "...display_output_wayland::set_font(...)").
        target = elf.off(elf.vma(jae_off) + 6 + old_rel)
        if target is None:
            continue
        if any(t in names for _, t in rip_targets(elf, target, target + ASSERT_SCAN + 7, b"\x48\x8d\x0d", 7)):
            patches.append((jae_off, new_rel, False))

    if not patches:
        raise Unsupported("no set_font() assert matching the expected code")
    return patches


def main():
    if len(sys.argv) != 3:
        print("usage: patch-conky-wayland SRC DST", file=sys.stderr)
        return 1
    src, dst = sys.argv[1], sys.argv[2]
    try:
        data = bytearray(open(src, "rb").read())
        patches = find_patches(Elf(bytes(data)))
    except Unsupported as err:
        print(f"patch-conky-wayland: {src}: {err}", file=sys.stderr)
        return 3
    except (OSError, ValueError, IndexError, struct.error) as err:
        print(f"patch-conky-wayland: {src}: {err}", file=sys.stderr)
        return 1

    for jae_off, new_rel, _ in patches:
        data[jae_off + 2:jae_off + 6] = struct.pack("<i", new_rel)

    # Write next to DST and rename, so a failure never leaves a half-patched copy.
    fd, tmp = tempfile.mkstemp(prefix=".conky-wayland.", dir=os.path.dirname(os.path.abspath(dst)))
    try:
        with os.fdopen(fd, "wb") as out:
            out.write(data)
        shutil.copymode(src, tmp)
        os.chmod(tmp, os.stat(tmp).st_mode | 0o111)
        os.replace(tmp, dst)
    except OSError as err:
        os.unlink(tmp)
        print(f"patch-conky-wayland: {dst}: {err}", file=sys.stderr)
        return 1

    done = ", ".join(f"{off:#x}{' (already)' if already else ''}" for off, _, already in patches)
    print(f"patch-conky-wayland: set_font() assert -> skip at file offset {done} -> {dst}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
